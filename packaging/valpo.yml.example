# Valpo production config for the fixed Ubuntu 26.04 LTS host layout.
# The installer copies this file only when /etc/valpo/valpo.yml is absent,
# then preserves operator edits and enforces root:valpo mode 0640.
# Direct commands must set VALPO_ENV=production to select this mapping.
production:
  config_schema: 1
  database_path: /var/lib/valpo/valpo.db
  encryption_key_path: /var/lib/valpo/secrets/master.key
  api_host: 127.0.0.1
  api_port: 7092
  caddy_config_path: /var/lib/valpo/caddy/valpo.caddy
  caddy_reload_config_path: /etc/caddy/Caddyfile
  docker_network: valpo
  worker_poll_interval: 2
  app_port_start: 20000
  app_port_end: 29999
  healthcheck_timeout: 30
  deploy_drain_delay: 2
  build_timeout: 1800
  build_log_limit: 16777216
  buildpack_builder: paketobuildpacks/builder-jammy-base@sha256:7510725172c8b2f1a7bce82b694e2af9599d5e2d97528c140eaeb81c569c21df
  image_retention_count: 3
  storage_cleanup_grace_period: 86400
  build_cache_retention: 2592000
  job_retention: 2592000
  container_log_max_size: 10m
  container_log_max_files: 3
