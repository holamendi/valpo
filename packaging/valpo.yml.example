# Valpo production config template for Ubuntu 26.04 LTS.
production:
  database_path: /var/lib/valpo/valpo.db
  api_host: 127.0.0.1
  api_port: 7092
  # Required before binding api_host to a non-local address.
  # api_token: change-me
  github_token_path: /var/lib/valpo/secrets/github-token
  github_app_credentials_path: /var/lib/valpo/secrets/github-app.json
  caddy_config_path: /var/lib/valpo/caddy/valpo.caddy
  caddy_reload_config_path: /etc/caddy/Caddyfile
  docker_network: valpo
  worker_poll_interval: 2
  app_port_start: 20000
  app_port_end: 29999
  healthcheck_timeout: 30
  deploy_drain_delay: 2
  build_timeout: 1800
  buildpack_builder: paketobuildpacks/ubuntu-noble-builder@sha256:6576792807752dfc227d0df115c99b0a77d97ddb71b4d6c757e99630c60db019
