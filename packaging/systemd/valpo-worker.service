[Unit]
Description=Valpo Worker
After=network-online.target docker.service valpo-migrate.service
Wants=network-online.target docker.service
Requires=valpo-migrate.service

[Service]
Type=simple
User=valpo
Group=valpo
UMask=0077
WorkingDirectory=/opt/valpo
Environment=VALPO_ENV=production
Environment=VALPO_CONFIG=/etc/valpo/valpo.yml
Environment=HOME=/var/lib/valpo
Environment=MISE_RUBY_COMPILE=false
Environment=PATH=/var/lib/valpo/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StateDirectory=valpo
LogsDirectory=valpo
ExecStart=/var/lib/valpo/.local/bin/mise x ruby@4.0.5 -- bundle exec exe/valpo-worker --config /etc/valpo/valpo.yml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
