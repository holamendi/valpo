[Unit]
Description=Valpo API
After=network-online.target valpo-migrate.service
Wants=network-online.target
Requires=valpo-migrate.service

[Service]
Type=simple
User=valpo
Group=valpo
WorkingDirectory=/opt/valpo
Environment=VALPO_ENV=production
Environment=VALPO_CONFIG=/etc/valpo/valpo.yml
StateDirectory=valpo
LogsDirectory=valpo
ExecStart=/usr/bin/env bundle exec exe/valpo-api --config /etc/valpo/valpo.yml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
