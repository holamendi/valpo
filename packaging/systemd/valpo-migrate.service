[Unit]
Description=Valpo Database Migration
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=valpo
Group=valpo
WorkingDirectory=/opt/valpo
Environment=VALPO_ENV=production
Environment=VALPO_CONFIG=/etc/valpo/valpo.yml
Environment=HOME=/var/lib/valpo
Environment=MISE_RUBY_COMPILE=false
StateDirectory=valpo
LogsDirectory=valpo
ExecStart=/var/lib/valpo/.local/bin/mise x ruby@4.0.5 -- bundle exec rake db:migrate
