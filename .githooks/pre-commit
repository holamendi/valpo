#!/usr/bin/env bash
set -euo pipefail

export RUBOCOP_CACHE_ROOT="${RUBOCOP_CACHE_ROOT:-tmp/rubocop_cache}"

before="$(mktemp)"
after="$(mktemp)"
cleanup() {
  rm -f "$before" "$after"
}
trap cleanup EXIT

git diff --binary > "$before"

bundle exec standardrb --fix

git diff --binary > "$after"
if ! cmp -s "$before" "$after"; then
  printf '%s\n' "standardrb --fix changed files. Review the changes, re-stage them, and commit again." >&2
  exit 1
fi
